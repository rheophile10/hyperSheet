{
  "name": "web-editor",
  "version": "0.0.1",
  "role": "application",
  "dependencies": ["html-template-parser", "dom"],
  "cels": [
    {
      "key": "webedit.source",
      "celType": "ValueCel",
      "metadata": { "key": "webedit.source", "segment": "web-editor" },
      "v": null
    },
    {
      "key": "webedit.mount",
      "celType": "ValueCel",
      "metadata": { "key": "webedit.mount", "segment": "web-editor" },
      "v": "#webedit"
    },
    {
      "key": "webedit.path",
      "celType": "ValueCel",
      "metadata": { "key": "webedit.path", "segment": "web-editor" },
      "v": "webedit.json"
    },
    {
      "key": "webedit.status",
      "celType": "ValueCel",
      "metadata": { "key": "webedit.status", "segment": "web-editor" },
      "v": "ready"
    },
    {
      "key": "webedit.input-binding",
      "celType": "ValueCel",
      "metadata": { "key": "webedit.input-binding", "segment": "web-editor" },
      "v": { "set": "webedit.source", "extract": "value" }
    },
    {
      "key": "webedit.view",
      "celType": "FormulaCel",
      "metadata": {
        "key": "webedit.view",
        "segment": "web-editor",
        "parser": "html-template",
        "schema": "render-spec",
        "channel": ["dom.paint"],
        "inputMap": {
          "source": "webedit.source",
          "mount": "webedit.mount",
          "binding": "webedit.input-binding",
          "status": "webedit.status"
        }
      },
      "f": "<div class=\"webedit\" id=\"webedit\">\n  <div class=\"webedit-toolbar\">\n    <button class=\"webedit-run\" onClick={{(dispatch webedit.run)}}>▶ Run</button>\n    <button class=\"webedit-clear\" onClick={{(dispatch webedit.clear)}}>Clear</button>\n    <span class=\"sep\">·</span>\n    <button onClick={{(dispatch webedit.load-counter)}}>Load Counter</button>\n    <button onClick={{(dispatch webedit.load-weather)}}>Load Weather</button>\n    <span class=\"sep\">·</span>\n    <button onClick={{(dispatch webedit.save)}}>Save</button>\n    <button onClick={{(dispatch webedit.load)}}>Load file</button>\n    <span class=\"webedit-status\">{{status}}</span>\n  </div>\n  <div class=\"webedit-split\">\n    <textarea class=\"webedit-source\" rows=\"20\"\n              value={{source}} onInput={{binding}}\n              spellcheck=\"false\"></textarea>\n    <div class=\"webedit-preview-wrap\">\n      <div class=\"webedit-preview-label\">preview root: #webedit-preview</div>\n      <div id=\"webedit-preview\"></div>\n    </div>\n  </div>\n</div>"
    }
  ]
}
