# Local-only working docs
examples/plastron-sheet/plan.md
notes/
docs/
# …EXCEPT the baked demo documents: bundle.ts bakes apps/docs/*.json into the
# deployed index.html, so CI needs them in the repo (materialize-docs is gone;
# these are hand-maintained SOURCE now, not build output).
!plastron-examples/origin/apps/docs/
!plastron-examples/origin/apps/docs/**

# Bench output (one JSON per run; not source-of-truth)
bench/results/

# Pictograph dehydrate output — regenerated by `npm start`.
plastron-examples/pictograph/甲骨.json

# Runtime file-store data — created by node-fs backend when bun runs.
# (.plastron-fs-*/ and the short-named .fl/.t6/.t7 variants are per-test stores.)
.plastron-fs/
.plastron-fs-*/
plastron/.fl/
plastron/.t6/
plastron/.t7/

# Tmp e2e logs.
/tmp/e2e-*.log
.claude/
plastron-examples/*/doom-assets-inline.ts



# local AI-assistant config — not part of the product
CLAUDE.md
.mcp.json

.env
graphify-out/
/Spreadshit.html

# e2e test screenshots (regenerated each run)
plastron-examples/origin/e2e/*.png

# Supabase / LLM provider secrets — NEVER commit project refs or API keys.
# Real project URL + anon key go in a gitignored local config or runtime cels;
# the xAI/provider key lives ONLY in Supabase function secrets (server-side).
**/supabase/.env
**/supabase/.temp/
**/supabase/.branches/
**/functions/**/.env
.env.production
*.secret
*.secret.*
*.local.json
secrets.json
