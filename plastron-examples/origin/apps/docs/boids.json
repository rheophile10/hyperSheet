  "manifests": [
    {
      "name": "boids",
      "version": "0.1.0",
      "description": "60 fish, formula-first (a sheetapp document), stacked in one vertical column: params in B2:B10, THE STEERING RULE as a =LAMBDA in B11, the position/velocity tables in B12/B13, the steer/move systems as formulas in B14/B15, and the pump in B16 committing each frame back through the graph. Open it, press ▶ run, edit any cell mid-swim - including the rule.",
      "role": "user-space",
      "kind": "origin-user",
      "applications": [
        "sheetapp"
      ],
      "dependencies": [
        "sheetapp",
        "ecs",
        "dom",
        "plastron-canvas",
        "origin"
      ]
    }
  ]
}