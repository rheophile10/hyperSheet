            "name": "A11",
            "description": "rule label"
          },
          "v": "rule =LAMBDA — EDIT ME"
        },
        {
          "key": "boids.B11",
          "celType": "FormulaCel",
          "metadata": {
            "key": "boids.B11",
            "segment": "boids",
            "name": "B11",
            "description": "THE STEERING RULE the B14 system maps over every fish: (pos, vel, nbrs, cohesion, alignment, separation, maxSpeed) -> [vx, vy]. EDIT IT mid-swim and the flock changes course - the rule is a cell, not native code (the 10k doc compiles the same idea to wat).",
            "parser": "infix"
          },
          "f": "=LAMBDA(pos, vel, nbrs, cohesion, alignment, separation, maxSpeed, LET(\n\tpx, pos[0],  py, pos[1],\n\tn, REDUCE(0, nbrs, LAMBDA(a, r, a + 1)),\n\tcx, REDUCE(0, nbrs, LAMBDA(a, r, a + r[0][0])),\n\tcy, REDUCE(0, nbrs, LAMBDA(a, r, a + r[0][1])),\n\tax, REDUCE(0, nbrs, LAMBDA(a, r, a + r[1][0])),\n\tay, REDUCE(0, nbrs, LAMBDA(a, r, a + r[1][1])),\n\tsx, REDUCE(0, nbrs, LAMBDA(a, r, a + (px - r[0][0]) / MAX(1, (px - r[0][0])*(px - r[0][0]) + (py - r[0][1])*(py - r[0][1])))),\n\tsy, REDUCE(0, nbrs, LAMBDA(a, r, a + (py - r[0][1]) / MAX(1, (px - r[0][0])*(px - r[0][0]) + (py - r[0][1])*(py - r[0][1])))),\n\tvx, IF(n = 0, vel[0], vel[0] + (cx/n - px)*cohesion + (ax/n - vel[0])*alignment + sx*separation*40),\n\tvy, IF(n = 0, vel[1], vel[1] + (cy/n - py)*cohesion + (ay/n - vel[1])*alignment + sy*separation*40),\n\tsq, vx*vx + vy*vy,\n\tspeed, LET(ga, MAX(ABS(vx), ABS(vy), 0.0001), gb, (ga + sq/ga)/2, (gb + sq/gb)/2),\n\tclamped, MIN(MAX(speed, 0.6), MAX(0.6, maxSpeed)),\n\t[vx * clamped / speed, vy * clamped / speed]))"
        },
