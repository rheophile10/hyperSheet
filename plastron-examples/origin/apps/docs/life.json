            "name": "A9",
            "description": "rule label"
          },
          "v": "rule (wat)"
        },
        {
          "key": "life.B9",
          "celType": "FormulaCel",
          "metadata": {
            "key": "life.B9",
            "segment": "life",
            "name": "B9",
            "description": "THE RULE, compiled tier: the same Conway rule as B2 in WebAssembly text - identical ABI (alive, n) -> 0|1. EDIT ME: the B10 binder recompiles it mid-run. (The cell is an infix formula returning the source string - the ='...' wrapper keeps a leading '(' from reading as an s-expr on commit, so bar edits round-trip.)",
            "parser": "infix"
          },
          "f": "='(module (func (export \"main\") (param $alive f64) (param $n f64) (result f64)\n  (if (result f64) (f64.gt (local.get $alive) (f64.const 0))\n    (then (select (f64.const 1) (f64.const 0)\n      (i32.or (f64.eq (local.get $n) (f64.const 2)) (f64.eq (local.get $n) (f64.const 3)))))\n    (else (select (f64.const 1) (f64.const 0) (f64.eq (local.get $n) (f64.const 3)))))\n))'"
        },
        {
          "key": "life.A10",
          "celType": "ValueCel",
          "metadata": {
            "key": "life.A10",
            "segment": "life",
            "name": "A10",
            "description": "rule label"
          },
          "v": "binder"
        },
        {
          "key": "life.B10",
          "celType": "FormulaCel",
          "metadata": {
            "key": "life.B10",
            "segment": "life",
            "name": "B10",
            "description": "the BINDER: compiles the wat source in B9 and commits it as the named lambda life.rulewat (definedBy this cell, origin B9). The rule you read and edit is B9, ON the sheet.",
            "parser": "infix"
          },
          "f": "=WAT(B9, 'life.rulewat', TRUE)"
        },
        {
