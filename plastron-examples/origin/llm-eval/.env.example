# Copy to .env (gitignored) and fill in. The harness skips any provider with a blank key.
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
ANTHROPIC_MODEL=claude-opus-4-8
XAI_MODEL=grok-4
OPENAI_MODEL=gpt-5

# Local model on your own box (3090) via an OpenAI-compatible server.
# Enabled when LOCAL_MODEL is set; skipped (with a reason) if the endpoint is down.
#   Ollama:    LOCAL_BASE_URL=http://localhost:11434/v1   LOCAL_MODEL=qwen2.5-coder:7b
#   LM Studio: LOCAL_BASE_URL=http://localhost:1234/v1    LOCAL_MODEL=<loaded model>
#   llama.cpp/vLLM: point LOCAL_BASE_URL at its /v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
LOCAL_API_KEY=ollama

# Rubric judge (text). Defaults to your XAI grok model; override to use a stronger judge.
JUDGE_MODEL=
